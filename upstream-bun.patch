+async function readBundledFile(srcPath: string, filename: string): Promise<Buffer> {
+	try {
+		return await readLocalFile(srcPath);
+	} catch (err) {
+		const bun = (globalThis as { Bun?: { file?: (path: string) => { arrayBuffer: () => Promise<ArrayBuffer> } } }).Bun;
+		if (!bun?.file || (err as NodeJS.ErrnoException).code !== 'ENOENT') {
+			throw err;
+		}
+
+		const candidates = new Set<string>();
+		candidates.add(srcPath);
+		candidates.add(path.resolve(srcPath));
+		const relative = path.relative(process.cwd(), srcPath).replace(/\\/g, '/');
+		if (relative && !relative.startsWith('..')) {
+			candidates.add(relative);
+			candidates.add(`./${relative}`);
+		}
+		candidates.add(path.join('scripts', filename).replace(/\\/g, '/'));
+		candidates.add(`./${path.join('scripts', filename).replace(/\\/g, '/')}`);
+		candidates.add(path.join(__dirname, '..', '..', 'scripts', filename));
+		const scriptsIndex = srcPath.replace(/\\/g, '/').indexOf('/scripts/');
+		if (scriptsIndex !== -1) {
+			const suffix = srcPath.replace(/\\/g, '/').slice(scriptsIndex + 1);
+			candidates.add(suffix);
+			candidates.add(`./${suffix}`);
+			candidates.add(`/${suffix}`);
+		}
+
+		for (const candidate of candidates) {
+			try {
+				return Buffer.from(await bun.file(candidate).arrayBuffer());
+			} catch {
+				// Try next candidate.
+			}
+		}
+
+		if (filename === 'updateUID.Dockerfile') {
+			return Buffer.from(updateUIDDockerfileText);
+		}
+
+		throw err;
+	}
+}
